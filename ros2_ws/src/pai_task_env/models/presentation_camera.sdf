<?xml version="1.0"?>
<!-- 動画・レポート撮影用のカメラ（実験には使わない）。scripts/sim/presentation_camera.sh で撮影時だけ追加する。
     pose はスクリプト側で上書きする（world 座標。ロボット土台は z=1.015） -->
<sdf version="1.8">
  <model name="presentation_camera">
    <static>true</static>
    <link name="link">
      <sensor name="camera" type="camera">
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <topic>/task/presentation/image</topic>
        <camera>
          <horizontal_fov>0.9</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.02</near><far>5.0</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
